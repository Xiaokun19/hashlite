<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层（108dp，含四周 18dp 出血）。
  几何与 icon/ic_launcher.svg 对应（512 空间 → 108 层，比例 0.2109）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 冷蓝 → 青的对角渐变 -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF4C87F8" />
                <item android:offset="0.52" android:color="#FF2A6BE8" />
                <item android:offset="1" android:color="#FF0E7F76" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上柔光，增加层次 -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30.2"
                android:centerY="21.6"
                android:gradientRadius="66.9">
                <item android:offset="0" android:color="#47FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
